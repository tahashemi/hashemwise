# Hashemwise configuration.
# Copy to .env and fill in. Never commit .env.

# From @BotFather.
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Your own Telegram user id (a positive number, from @userinfobot).
# This account authorizes groups and is the only one that can view /history
# or edit/delete entries.
SUPER_ADMIN_ID=0

# Where the SQLite ledger lives. Inside Docker this is the mounted volume.
DB_PATH=data/ledger.db

# Optional. Leave empty for a direct connection to api.telegram.org.
# Examples: http://127.0.0.1:8080  |  socks5://user:pass@host:1080
TELEGRAM_PROXY=

LOG_LEVEL=INFO
